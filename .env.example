# Copy this file to .env and change any value you want to override.
# Every setting is optional; the defaults live in src/hybrid_rag/config.py.

# --- Models ---
# RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # or BAAI/bge-reranker-base (larger, more accurate)
# RAG_LLM_MODEL=qwen2.5:1.5b               # qwen2.5:3b / qwen2.5:7b answer better but are larger and slower
# RAG_OLLAMA_HOST=http://localhost:11434
# RAG_LLM_TEMPERATURE=0.1
# RAG_LLM_NUM_CTX=8192
# RAG_DEVICE=auto            # auto | cpu | cuda

# --- Chunking (sizes in characters) ---
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=120

# --- Retrieval ---
# RAG_DENSE_TOP_K=50
# RAG_SPARSE_TOP_K=50
# RAG_RRF_K=60
# RAG_DENSE_WEIGHT=1.0
# RAG_SPARSE_WEIGHT=1.0
# RAG_FUSION_TOP_K=50
# RAG_RERANK_TOP_K=5
# RAG_MIN_RELEVANCE=0.01   # reranker score below which the LLM isn't asked (0 = off)

# --- Storage ---
# RAG_DATA_DIR=data
# RAG_COLLECTION_NAME=documents
